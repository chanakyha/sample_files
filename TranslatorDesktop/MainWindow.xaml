<Window x:Class="TranslatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TranslatorDesktop"
        Title="EU Translator" Height="640" Width="920" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="14"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel>
        <!-- Nav bar: hovering "Translate" opens the language list -->
        <Menu x:Name="NavBar" DockPanel.Dock="Top" Background="{StaticResource NavBg}"
              Foreground="White" Padding="8,4" FontSize="14">
            <MenuItem x:Name="TranslateMenu" Header="_Translate" Padding="12,6"
                      Foreground="White" FontWeight="SemiBold"
                      MouseEnter="TranslateMenu_MouseEnter"
                      AutomationProperties.AutomationId="TranslateMenu"/>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="White" Padding="8,2"
                   BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="Gray"
                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Starting…"
                               AutomationProperties.AutomationId="StatusText"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LanguageText"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TimingText" Foreground="{StaticResource Muted}"
                           AutomationProperties.AutomationId="TimingText"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Input: add a new row, translate all rows -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="16,12"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="InputBox" Padding="8,7" VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource CardBorder}"
                             TextChanged="InputBox_TextChanged" KeyDown="InputBox_KeyDown"
                             AutomationProperties.AutomationId="InputBox"/>
                    <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="#9CA3AF"
                               Text="Type text in any EU language and press Enter to add it…"/>
                </Grid>
                <Button x:Name="AddButton" Grid.Column="1" Content="Add" Margin="8,0,0,0"
                        Style="{StaticResource FlatButton}" Click="AddButton_Click"
                        AutomationProperties.AutomationId="AddButton"/>
                <Button x:Name="TranslateButton" Grid.Column="2" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="TranslateButton_Click"
                        Content="Translate → English"
                        AutomationProperties.AutomationId="TranslateButton"/>
            </Grid>
        </Border>

        <!-- Rows of text -->
        <Grid Margin="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="ShowOriginalButton" DockPanel.Dock="Right" Content="Show original"
                        Style="{StaticResource FlatButton}" Padding="12,4" Margin="8,0,0,0"
                        Click="ShowOriginalButton_Click"
                        AutomationProperties.AutomationId="ShowOriginalButton"/>
                <Button DockPanel.Dock="Right" Content="Clear all" Padding="12,4"
                        Style="{StaticResource FlatButton}" Click="ClearButton_Click"
                        AutomationProperties.AutomationId="ClearButton"/>
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="Texts"/>
            </DockPanel>
            <ScrollViewer x:Name="RowsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsList" AutomationProperties.AutomationId="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TextRow}">
                            <Border Background="White" CornerRadius="8" Padding="14,10"
                                    Margin="0,0,0,8" BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBox Text="{Binding Display, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Padding="0" TextWrapping="Wrap" FontSize="15"
                                                 AutomationProperties.AutomationId="RowText"/>
                                        <TextBlock Text="{Binding Original}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding ShowOriginal, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BadgeBg}"
                                            CornerRadius="10" Padding="8,2" Margin="12,0,4,0"
                                            VerticalAlignment="Center" ToolTip="{Binding BadgeToolTip}"
                                            Visibility="{Binding IsTranslated, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="✕" ToolTip="Remove"
                                            Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                            Tag="{Binding}" Click="RemoveRow_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
