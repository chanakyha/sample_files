<Window x:Class="TranslatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EU Translator" Width="760" Height="560" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Starting..." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Texts (language detected automatically):" Padding="0,0,0,4" />
            <ListBox Grid.Row="1" x:Name="TextList" DisplayMemberPath="Display" />

            <DockPanel Grid.Row="2" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" x:Name="AddButton" Content="Add" Width="75" Margin="6,0,0,0"
                        Click="AddButton_Click" />
                <TextBox x:Name="InputBox" KeyDown="InputBox_KeyDown" />
            </DockPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="EnglishButton" Content="English" Width="90" Margin="0,0,6,0" Tag="en"
                        Click="TranslateButton_Click" />
                <Button x:Name="FrenchButton" Content="French" Width="90" Margin="0,0,6,0" Tag="fr"
                        Click="TranslateButton_Click" />
                <Button x:Name="SpanishButton" Content="Spanish" Width="90" Tag="es"
                        Click="TranslateButton_Click" />
            </StackPanel>

            <Label Grid.Row="4" Content="Result:" Padding="0,8,0,4" />
            <TextBox Grid.Row="5" x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
        </Grid>
    </DockPanel>
</Window>
