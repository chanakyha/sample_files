<Window x:Class="TranslatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EU Translator" Height="600" Width="900"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel>
        <!-- Hovering "Translate" opens the list of target languages -->
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="TranslateMenu" Header="_Translate"
                      MouseEnter="TranslateMenu_MouseEnter"
                      AutomationProperties.AutomationId="TranslateMenu"/>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Starting…"
                           AutomationProperties.AutomationId="StatusText"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LanguageText"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TimingText" AutomationProperties.AutomationId="TimingText"/>
            </StatusBarItem>
        </StatusBar>

        <DockPanel DockPanel.Dock="Bottom" Margin="4">
            <Label DockPanel.Dock="Left" Content="_Text:" Target="{Binding ElementName=InputBox}"/>
            <Button x:Name="TranslateButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2"
                    Content="Translate → English" Click="TranslateButton_Click"
                    AutomationProperties.AutomationId="TranslateButton"/>
            <Button x:Name="AddButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2"
                    Content="Add" Click="AddButton_Click"
                    AutomationProperties.AutomationId="AddButton"/>
            <TextBox x:Name="InputBox" VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown"
                     AutomationProperties.AutomationId="InputBox"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="4">
            <Button x:Name="ShowOriginalButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2"
                    Content="Show original" Click="ShowOriginalButton_Click"
                    AutomationProperties.AutomationId="ShowOriginalButton"/>
            <Button DockPanel.Dock="Right" Padding="8,2" Content="Clear all" Click="ClearButton_Click"
                    AutomationProperties.AutomationId="ClearButton"/>
            <TextBlock x:Name="HeaderText" VerticalAlignment="Center" Text="Texts"/>
        </DockPanel>

        <!-- Hover a row: tooltip with the source -> target language and the original text -->
        <ListView x:Name="RowsList" Margin="4,0,4,0" AutomationProperties.AutomationId="RowsList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Text" Width="760">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Display, Mode=OneWay}" IsReadOnly="True"
                                         BorderThickness="0" TextWrapping="Wrap" Width="740"
                                         ToolTip="{Binding ToolTipText}"
                                         AutomationProperties.AutomationId="RowText"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" Tag="{Binding}" Click="RemoveRow_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
